rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // PDC (PERSONALITY DEVELOPMENT CLUB) ASSESSMENT SUBMISSIONS
    // =====================================================================
    // Collection: pdc_test_submissions
    // Purpose: Store student assessment responses (no authentication required)
    // Access: Public write (form submissions), No public read
    // Assessment: 20 Questions — 7 PQ (max 35) + 6 IQ (max 30) + 7 EQ (max 35) = 100
    // =====================================================================

    match /pdc_test_submissions/{submissionId} {

      // ───────────────────────────────────────────────────────────────────
      // ALLOW: Create (Public form submissions)
      // ───────────────────────────────────────────────────────────────────
      // - No authentication required (public student evaluation form)
      // - Strict field validation to prevent abuse or data injection
      // - Data type and size restrictions
      // - Score range validation per dimension maximum
      // ───────────────────────────────────────────────────────────────────

      allow create: if
        // Request must contain ONLY these validated fields
        request.resource.data.keys().hasOnly([
          'fullName',
          'email',
          'whatsappNumber',
          'gender',
          'homeTown',
          'campus',
          'branch',
          'division',
          'year',
          'answers',
          'scores',
          'totalScore',
          'timestamp',
          'submittedAt',
          'userAgent'
        ])

        // ─────────────────────────────────────────────────────────────────
        // REQUIRED PERSONAL INFORMATION
        // ─────────────────────────────────────────────────────────────────
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120

        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254

        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() >= 10
        && request.resource.data.whatsappNumber.size() <= 15

        && request.resource.data.gender is string
        && request.resource.data.gender in ['Male', 'Female', 'Other']

        && request.resource.data.homeTown is string
        && request.resource.data.homeTown.size() > 0
        && request.resource.data.homeTown.size() <= 100

        && request.resource.data.campus is string
        && request.resource.data.campus in ['Bibwewadi', 'Kondhwa']
        && request.resource.data.campus == 'Bibwewadi'

        && request.resource.data.branch is string
        && request.resource.data.branch.size() > 0
        && request.resource.data.branch.size() <= 100

        && request.resource.data.division is string
        && request.resource.data.division in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'SEDA']

        && request.resource.data.year is string
        && request.resource.data.year in ['FY', 'SY', 'TY', 'Final Year']

        // ─────────────────────────────────────────────────────────────────
        // ASSESSMENT DATA VALIDATION
        // ─────────────────────────────────────────────────────────────────
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 20

        && request.resource.data.scores is map
        // Supports EQ (Emotional Quotient) and optional SQ alias
        && request.resource.data.scores.pq is number
        && request.resource.data.scores.pq >= 0
        && request.resource.data.scores.pq <= 35

        && request.resource.data.scores.iq is number
        && request.resource.data.scores.iq >= 0
        && request.resource.data.scores.iq <= 30

        && (
          (request.resource.data.scores.keys().hasAny(['eq']) && request.resource.data.scores.eq is number && request.resource.data.scores.eq >= 0 && request.resource.data.scores.eq <= 35) ||
          (request.resource.data.scores.keys().hasAny(['sq']) && request.resource.data.scores.sq is number && request.resource.data.scores.sq >= 0 && request.resource.data.scores.sq <= 35)
        )

        // ─────────────────────────────────────────────────────────────────
        // OVERALL SCORE VALIDATION (0–100)
        // ─────────────────────────────────────────────────────────────────
        && request.resource.data.totalScore is number
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 100

        // ─────────────────────────────────────────────────────────────────
        // METADATA VALIDATION
        // ─────────────────────────────────────────────────────────────────
        && request.resource.data.timestamp is string
        && request.resource.data.submittedAt is string
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() > 0
        && request.resource.data.userAgent.size() <= 500;

      // Immutable & Private Submissions
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Explicitly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
