rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // PDC (PERSONALITY DEVELOPMENT CLUB) ASSESSMENT SUBMISSIONS
    // =====================================================================
    // Separate collections for campus management:
    // 1. pdc_bibwewadi_submissions — Bibwewadi Campus Submissions
    // 2. pdc_kondhwa_submissions   — Kondhwa Campus Submissions
    // 3. pdc_test_submissions      — Legacy / Compatibility Collection
    //
    // Access: Public write (form submissions), No public read
    // Assessment: 20 Questions — 7 PQ (max 35) + 6 IQ (max 30) + 7 EQ (max 35) = 100
    // =====================================================================

    // Common helper function validating assessment payload fields
    function isValidAssessmentSubmission(data, expectedCampus) {
      return data.keys().hasOnly([
        'fullName',
        'email',
        'whatsappNumber',
        'gender',
        'homeTown',
        'campus',
        'branch',
        'division',
        'year',
        'answers',
        'answersByQuestion',
        'questionIds',
        'selectedOptionIds',
        'scores',
        'totalScore',
        'timestamp',
        'submittedAt',
        'userAgent',
        'personalityDimensions',
        'primaryProfile',
        'secondaryProfile',
        'cognitiveScore',
        'cognitiveProfile',
        'spiritualDimensions',
        'spiritualProfile',
        'report',
        'joinedCommunity',
        'whatsappJoined',
        'hasJoinedWhatsapp'
      ])
      // Required Personal Information
      && data.fullName is string
      && data.fullName.size() > 0
      && data.fullName.size() <= 120

      && data.email is string
      && data.email.size() > 0
      && data.email.size() <= 254

      && data.whatsappNumber is string
      && data.whatsappNumber.size() >= 10
      && data.whatsappNumber.size() <= 15

      && data.gender is string
      && data.gender in ['Male', 'Female', 'Other']

      && data.homeTown is string
      && data.homeTown.size() > 0
      && data.homeTown.size() <= 100

      // Campus segregation
      && data.campus is string
      && (
        (expectedCampus == 'ANY' && data.campus in ['Bibwewadi', 'Kondhwa']) ||
        (expectedCampus != 'ANY' && data.campus == expectedCampus)
      )

      && data.branch is string
      && data.branch.size() > 0
      && data.branch.size() <= 100

      && data.division is string
      && data.division in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'SEDA']

      && data.year is string
      && data.year in ['FY', 'SY', 'TY', 'Final Year']

      // Assessment Responses & Scores
      && data.answers is map
      && data.answers.size() <= 20

      && data.scores is map
      && data.scores.pq is number
      && data.scores.pq >= 0
      && data.scores.pq <= 35

      && data.scores.iq is number
      && data.scores.iq >= 0
      && data.scores.iq <= 30

      && (
        (data.scores.keys().hasAny(['eq']) && data.scores.eq is number && data.scores.eq >= 0 && data.scores.eq <= 35) ||
        (data.scores.keys().hasAny(['sq']) && data.scores.sq is number && data.scores.sq >= 0 && data.scores.sq <= 35)
      )

      && data.totalScore is number
      && data.totalScore >= 0
      && data.totalScore <= 100

      // Community / WhatsApp tracking for database management
      && (!data.keys().hasAny(['joinedCommunity']) || (data.joinedCommunity is string && data.joinedCommunity in ['yes', 'no']))
      && (!data.keys().hasAny(['whatsappJoined']) || data.whatsappJoined is bool)
      && (!data.keys().hasAny(['hasJoinedWhatsapp']) || data.hasJoinedWhatsapp is bool)

      // Metadata
      && data.timestamp is string
      && data.submittedAt is string
      && data.userAgent is string
      && data.userAgent.size() > 0
      && data.userAgent.size() <= 500;
    }

    // ───────────────────────────────────────────────────────────────────
    // 1. BIBWEWADI CAMPUS SUBMISSIONS
    // ───────────────────────────────────────────────────────────────────
    match /pdc_bibwewadi_submissions/{submissionId} {
      allow create: if isValidAssessmentSubmission(request.resource.data, 'Bibwewadi');
      allow read, update, delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────
    // 2. KONDHWA CAMPUS SUBMISSIONS
    // ───────────────────────────────────────────────────────────────────
    match /pdc_kondhwa_submissions/{submissionId} {
      allow create: if isValidAssessmentSubmission(request.resource.data, 'Kondhwa');
      allow read, update, delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────
    // 3. LEGACY / COMPATIBILITY SUBMISSIONS
    // ───────────────────────────────────────────────────────────────────
    match /pdc_test_submissions/{submissionId} {
      allow create: if isValidAssessmentSubmission(request.resource.data, 'ANY');
      allow read, update, delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────
    // 4. PUBLIC AGGREGATED STATS (Live registration & WhatsApp counter)
    // ───────────────────────────────────────────────────────────────────
    match /pdc_stats/{docId} {
      allow read: if true;
      allow create, update: if (
        request.resource.data.totalRegistered is number ||
        request.resource.data.whatsappJoinedCount is number
      );
      allow delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────
    // 5. WHATSAPP COMMUNITY JOINS (Dedicated collection to check joins)
    // ───────────────────────────────────────────────────────────────────
    match /pdc_whatsapp_joins/{joinId} {
      allow read: if true;
      allow create: if request.resource.data.fullName is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    // Explicitly deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
